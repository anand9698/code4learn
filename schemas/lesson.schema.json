{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Subtopic lesson",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "overview", "sections"],
  "properties": {
    "name": { "$ref": "#/definitions/text" },
    "overview": { "$ref": "#/definitions/text" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "content"],
        "properties": {
          "title": { "$ref": "#/definitions/text" },
          "content": { "$ref": "#/definitions/text" },
          "subsections": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/subsection" } },
          "codeExamples": { "$ref": "#/definitions/codeExamples" },
          "images": { "$ref": "#/definitions/images" }
        }
      }
    },
    "codeExamples": { "$ref": "#/definitions/codeExamples" },
    "images": { "$ref": "#/definitions/images" },
    "keyPoints": { "$ref": "#/definitions/textList" },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "$ref": "#/definitions/text" },
          "url": { "type": "string", "pattern": "^https?://[^/\\s]+[^\\s]*$" }
        }
      }
    },
    "interviewQA": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer"],
        "properties": {
          "question": { "$ref": "#/definitions/text" },
          "answer": { "$ref": "#/definitions/text" },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "tags": { "$ref": "#/definitions/textList" }
        }
      }
    }
  },
  "definitions": {
    "text": { "type": "string", "pattern": "\\S" },
    "textList": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } },
    "subsection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "anyOf": [
        { "required": ["content"] },
        { "required": ["table"] }
      ],
      "properties": {
        "title": { "$ref": "#/definitions/text" },
        "content": { "$ref": "#/definitions/text" },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headers", "rows"],
          "properties": {
            "headers": { "$ref": "#/definitions/textList" },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "codeExamples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "code", "language"],
        "properties": {
          "title": { "$ref": "#/definitions/text" },
          "description": { "$ref": "#/definitions/text" },
          "code": { "$ref": "#/definitions/text" },
          "language": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_+-]*$" }
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "alt"],
        "properties": {
          "url": { "type": "string", "pattern": "^assets/images/(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.[a-zA-Z0-9]+$" },
          "alt": { "$ref": "#/definitions/text" },
          "caption": { "$ref": "#/definitions/text" }
        }
      }
    }
  }
}
